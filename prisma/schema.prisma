datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Workspace {
  id               String               @id @default(cuid())
  name             String
  slug             String               @unique
  stripeCustomerId String?
  plan             String               @default("FREE") // FREE, PRO, ENTERPRISE
  websiteUrl       String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  apiKeys          WorkspaceApiKey[]
  connections      ChannelConnection[]
  workflows        Workflow[]
  campaignRuns     CampaignRun[]

  @@index([slug])
}

model WorkspaceApiKey {
  id           String      @id @default(cuid())
  workspaceId  String
  provider     String      // OPENAI, GOOGLE_AI, ANTHROPIC
  encryptedKey String
  iv           String
  tag          String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  workspace    Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider])
  @@index([workspaceId])
}

model ChannelConnection {
  id                   String           @id @default(cuid())
  workspaceId          String
  platform             String           // YOUTUBE, WHATSAPP, TELEGRAM, PINTEREST, REDDIT, THREADS, TWITTER, LINKEDIN, INSTAGRAM, DEVTO, DISCORD
  accountName          String
  encryptedAccessToken String
  encryptedRefreshToken String?
  tokenExpiresAt       DateTime?
  metadata             String           @default("{}") // JSON string
  iv                   String
  tag                  String
  status               String           @default("ACTIVE") // ACTIVE, EXPIRED, ERROR
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  workspace            Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, platform, accountName])
  @@index([workspaceId, platform])
}

model Workflow {
  id             String        @id @default(cuid())
  workspaceId    String
  name           String
  nodes          String        // React Flow DAG nodes JSON string
  edges          String        // React Flow DAG connections JSON string
  cronExpression String        @default("0 8 * * *")
  timezone       String        @default("UTC")
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaignRuns   CampaignRun[]

  @@index([workspaceId, isActive])
}

model CampaignRun {
  id               String         @id @default(cuid())
  workspaceId      String
  workflowId       String?
  status           String         @default("QUEUED") // QUEUED, PROCESSING, COMPLETED, PARTIALLY_FAILED, FAILED
  seedTopic        String
  targetUrl        String
  canonicalPayload String         // JSON containing all generated platform variants
  mediaUrls        String         @default("[]") // JSON string array
  idempotencyKey   String         @unique // workspaceId:date:hash
  createdAt        DateTime       @default(now())
  completedAt      DateTime?

  workspace        Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workflow         Workflow?      @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  publishLogs      PublishLog[]

  @@index([workspaceId, createdAt])
  @@index([idempotencyKey])
}

model PublishLog {
  id            String        @id @default(cuid())
  campaignRunId String
  channel       String        // Platform enum string
  status        String        // SUCCESS, FAILED, RETRYING
  attempts      Int           @default(1)
  externalPostId String?
  externalUrl   String?
  errorResponse String?
  executedAt    DateTime      @default(now())

  campaignRun   CampaignRun   @relation(fields: [campaignRunId], references: [id], onDelete: Cascade)

  @@index([campaignRunId, channel])
}
